# ==========================================
# 1. 네이버 메일 설정 (맥북/데스크탑 모든 OS 완벽 호환)
# ==========================================
NAVER_EMAIL=your_id@naver.com
NAVER_APP_PASSWORD=your_naver_app_password
NAVER_IMAP_SERVER=imap.naver.com

# [추천] 네이버 내 포스텍 메일 전용 격리 폴더 이름
# 네이버 자동분류로 포스텍 전달 메일을 이 폴더로 직행시키면 받은편지함이 절대 어지럽혀지지 않으며,
# 스크립트가 수집 직후 이 폴더의 전달본만 자동으로 비워줍니다(원본은 포스텍 메일함에 안전히 보관).
NAVER_POSTECH_FOLDER=POSTECH_BOT
AUTO_CLEAN_POSTECH_FOLDER=true

# ==========================================
# 2. 포스텍 학교 메일 직접 연결 (선택 - MS 365 IMAP 직접 연결 시)
# ==========================================
POSTECH_EMAIL=
POSTECH_PASSWORD=
POSTECH_IMAP_SERVER=outlook.office365.com

# ==========================================
# 3. Gemini API 키 (선택 - 안티그래비티 없이 단독/자동 실행할 때만 소량 사용)
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# 4. 알림 플랫폼 설정 (추후 결정 후 입력)
# ==========================================
# [디스코드 웹훅]
DISCORD_WEBHOOK_URL=

# [카카오톡 나에게 보내기]
KAKAO_REST_API_KEY=
KAKAO_REFRESH_TOKEN=